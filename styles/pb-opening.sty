%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% Parede Branca
%
% Abertura editorial dos capítulos
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\ProvidesPackage{pb-opening}[2026/08/18]

\RequirePackage{lettrine}
\RequirePackage{ragged2e}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Cores
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\definecolor{PBGray}{HTML}{707070}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Página de citação musical
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\PBmusicquote}[3]
{
    \cleardoublepage
    \thispagestyle{empty}

    \vspace*{0.24\textheight}

    \begin{center}
        {\titlefont\fontsize{18}{22}\selectfont\itshape
        ``#1''\par}

        \vspace{1.5cm}

        {\titlefont\fontsize{11}{14}\selectfont
        #2\par}

        \vspace{0.25cm}

        {\fontsize{10}{12}\selectfont\color{PBGray}
        #3\par}
    \end{center}

    \cleardoublepage
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Página de pensamento
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\PBthought}[1]
{
    \cleardoublepage
    \thispagestyle{empty}

    \vspace*{0.27\textheight}

    \begin{center}
        \begin{minipage}{0.72\textwidth}
            \centering
            {\titlefont\fontsize{17}{23}\selectfont\itshape
            #1\par}
        \end{minipage}
    \end{center}

    \cleardoublepage
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Primeira letra capitulada
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\PBdropcap}[2]
{
    \lettrine[
        lines=3,
        lraise=0.05,
        nindent=0pt,
        findent=0.15em
    ]{#1}{#2}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Início completo da abertura do capítulo
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\PBchapterstart}[1]
{
    \PBchapter{#1}
}
