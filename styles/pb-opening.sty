\ProvidesPackage{pb-opening}[2026/08/18]

\RequirePackage{lettrine}
\RequirePackage{wasysym}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Cores
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\definecolor{PBGray}{HTML}{707070}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Página de música — novo formato editorial
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\PBmusicpage}[3]
{
    \cleardoublepage
    \thispagestyle{plain}

    \vspace*{0.035\textheight}

    \begin{center}
        {\fontsize{23}{26}\selectfont\eighthnote\par}

        \vspace{0.5cm}

        {\titlefont\fontsize{18}{22}\selectfont
        #1\par}

        \vspace{0.5cm}

        {\titlefont\fontsize{12}{15}\selectfont
        #2\par}

        \vspace{0.6cm}

        \begin{minipage}{0.78\textwidth}
            \centering
            {\fontsize{11.5}{18}\selectfont\itshape
            #3\par}
        \end{minipage}
    \end{center}

    \cleardoublepage
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Compatibilidade com a forma anterior
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\PBmusicquote}[3]
{
    \PBmusicpage{#1}{#2}{#3}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Página de pensamento
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\PBthought}[1]
{
    \cleardoublepage
    \thispagestyle{plain}

    \vspace*{0.27\textheight}

    \begin{center}
        \begin{minipage}{0.72\textwidth}
            \centering
            {\titlefont\fontsize{17}{23}\selectfont\itshape
            #1\par}
        \end{minipage}
    \end{center}

    \cleardoublepage
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Primeira letra sem capitulação
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\PBdropcap}[2]
{
    #1#2
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Início do capítulo
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\PBchapterstart}[1]
{
    \PBchapter{#1}
}
