\ProvidesPackage{./styles/pb-cover}[2026/08/05]

\RequirePackage{xcolor}
\RequirePackage{graphicx}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Metadados
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\PBtitle}[1]{\def\@PBtitle{#1}}
\newcommand{\PBsubtitle}[1]{\def\@PBsubtitle{#1}}
\newcommand{\PBauthor}[1]{\def\@PBauthor{#1}}
\newcommand{\PBedition}[1]{\def\@PBedition{#1}}

\PBtitle{}
\PBsubtitle{}
\PBauthor{}
\PBedition{}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Página de rosto
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\PBmaketitle}{%

\cleardoublepage
\thispagestyle{empty}

\vspace*{\fill}

{\centering

{\titlefont\fontsize{34}{38}\selectfont
\@PBtitle\par}

\vspace{1cm}

\ifx\@PBsubtitle\empty
\else
{\Large\itshape
\@PBsubtitle\par}
\vspace{2cm}
\fi

\vfill

{\Large
\@PBauthor\par}

\vspace{0.5cm}

\ifx\@PBedition\empty
\else
{\small
\@PBedition\par}
\fi

}

\vspace*{\fill}

\cleardoublepage

}